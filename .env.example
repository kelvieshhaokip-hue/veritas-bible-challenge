PORT=3001
APP_URL=http://localhost:5173
DATABASE_PATH=./server/data/competition.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=organizer@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Keep true for local exploration; set false to require Stripe Checkout.
DEMO_MODE=true
ENTRY_FEE=250
CURRENCY=INR

# Required when DEMO_MODE=false. Keep all Stripe secrets on the server.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional email delivery through Resend. Use a sender on a verified domain.
RESEND_API_KEY=re_replace_me
EMAIL_FROM="Veritas Bible Challenge <no-reply@your-verified-domain.com>"
